<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inherit the website_sale_stock product_template form view to add
        the "Back in Stock Message" field in the Sales tab, below the
        existing Out-of-Stock Message field.
        Access restricted to the Sales Manager group.
    -->
    <record id="product_template_form_view_back_in_stock_msg" model="ir.ui.view">
        <field name="name">product.template.form.back.in.stock.msg</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale_stock.product_template_form_view_inherit_website_sale_stock"/>
        <field name="arch" type="xml">
            <!--
                The parent view adds fields after website_ribbon_id, ending with
                out_of_stock_message. We add our field right after that.
            -->
            <field name="out_of_stock_message" position="after">
                <field
                    name="back_in_stock_message"
                    invisible="not is_storable"
                    placeholder="e.g. 'Great news! This product is back in stock.'"
                    groups="sales_team.group_sale_manager"
                />
            </field>
        </field>
    </record>
</odoo>
