<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add SKU actions and SKU Product Code Template on Product Template form -->
    <record id="product_template_only_form_view_sku" model="ir.ui.view">
        <field name="name">product.template.form.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_generate_all_skus"
                            string="Generate All SKUs"
                            type="object"
                            class="btn-primary"
                            help="Generate Internal References (SKUs) for all variants of this product that do not currently have one using the selected SKU template."/>
                    <button name="action_clear_generated_skus"
                            string="Clear Generated SKUs"
                            type="object"
                            class="btn-secondary"
                            help="Safely clear generated Internal References (SKUs) for this product's variants without affecting barcodes or other data."/>
                </header>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="sku_template_id"
                       string="SKU Infix Template"
                       options="{'no_create_edit': False}"
                       placeholder="Select SKU Infix Template..."/>
            </xpath>
        </field>
    </record>

    <!-- Hide Internal Reference (default_code) column from Product Template List view -->
    <record id="product_template_tree_view_sku" model="ir.ui.view">
        <field name="name">product.template.tree.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <!-- Ensure default_code is formatted below Product Name in Product Template Kanban view -->
    <record id="product_template_kanban_view_sku" model="ir.ui.view">
        <field name="name">product.template.kanban.sku</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[field[@name='default_code']]" position="replace">
                <div t-if="record.default_code.value" class="text-muted small mb-1">
                    <strong>SKU :</strong> <field name="default_code"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
